<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- System splash (Android 12+): graphite background and the same inset logo as the launcher icon. -->
    <style name="Theme.SamsungControll" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/remote_background</item>
        <item name="android:colorBackground">@color/remote_background</item>
        <item name="android:colorAccent">@color/remote_accent</item>
        <item name="android:windowSplashScreenBackground">@color/remote_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
</resources>
